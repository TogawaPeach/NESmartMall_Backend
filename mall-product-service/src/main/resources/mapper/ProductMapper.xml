<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nemall.product.mapper.ProductMapper">

    <!-- 将数据库字段映射到商品卡片，显式处理封面地址、销量与 Java 属性名的差异。 -->
    <resultMap id="productCardMap"
               type="com.nemall.product.vo.ProductCardVO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="cover_image_url" property="coverUrl"/>
        <result column="price" property="price"/>
        <result column="sales_count" property="sales"/>
    </resultMap>

    <!--
        仅查询已上架（status=1）且未删除的商品。销量相同时按 ID 升序，保证相同数据下顺序稳定。
        limit 使用 MyBatis 参数绑定，由业务层校验为正数后传入。
    -->
    <select id="selectTopSales" resultMap="productCardMap">
        SELECT
        id,
        name,
        cover_image_url,
        price,
        sales_count
        FROM product
        WHERE status = 1
        AND is_deleted = 0
        ORDER BY sales_count DESC, id ASC
        LIMIT #{limit}
    </select>

</mapper>
